{
  "_comment": "SYNTHETIC environment shared by every benchmark case. Service names, account id (AWS documentation example 111122223333) and resource ids are invented.",
  "account": "111122223333",
  "services": {
    "edge":      {"tier": 1, "depends_on": ["checkout", "catalog", "search"]},
    "checkout":  {"tier": 1, "depends_on": ["payments", "identity", "catalog"]},
    "payments":  {"tier": 1, "depends_on": ["identity"]},
    "identity":  {"tier": 1, "depends_on": []},
    "catalog":   {"tier": 2, "depends_on": []},
    "search":    {"tier": 2, "depends_on": ["catalog"]},
    "reporting": {"tier": 3, "depends_on": ["payments"]},
    "batch":     {"tier": 3, "depends_on": []},
    "platform":  {"tier": 2, "depends_on": []}
  },
  "default_burn_rate": 0.4,
  "resources": {
    "aws_security_group.edge_alb":        {"service": "edge", "id": "sg-0e1a2b3c4d5e6f701"},
    "aws_security_group.bastion":         {"service": "batch", "id": "sg-0e1a2b3c4d5e6f702"},
    "aws_security_group.payments_db":     {"service": "payments", "id": "sg-0e1a2b3c4d5e6f703"},
    "aws_security_group.checkout_app":    {"service": "checkout", "id": "sg-0e1a2b3c4d5e6f704"},
    "aws_security_group.catalog_app":     {"service": "catalog", "id": "sg-0e1a2b3c4d5e6f705"},
    "aws_autoscaling_group.checkout":     {"service": "checkout", "id": "checkout-asg"},
    "aws_autoscaling_group.search":       {"service": "search", "id": "search-asg"},
    "aws_ecs_service.catalog_api":        {"service": "catalog", "id": "arn:aws:ecs:eu-west-1:111122223333:service/main/catalog-api"},
    "aws_ecs_service.payments_api":       {"service": "payments", "id": "arn:aws:ecs:eu-west-1:111122223333:service/main/payments-api"},
    "aws_db_instance.payments":           {"service": "payments", "id": "payments-db"},
    "aws_db_instance.reporting":          {"service": "reporting", "id": "reporting-db"},
    "aws_elasticache_replication_group.sessions": {"service": "identity", "id": "sessions"},
    "aws_s3_bucket_public_access_block.reports":  {"service": "reporting", "id": "acme-reports-exports"},
    "aws_s3_bucket_public_access_block.assets":   {"service": "edge", "id": "acme-static-assets"},
    "aws_route53_record.api":             {"service": "edge", "id": "Z0EXAMPLE_api.example.com_A"},
    "aws_route53_record.payments":        {"service": "payments", "id": "Z0EXAMPLE_payments.internal.example.com_CNAME"},
    "aws_iam_role_policy.batch_worker":   {"service": "batch", "id": "batch-worker:batch-worker-inline"},
    "aws_iam_role_policy.checkout_app":   {"service": "checkout", "id": "checkout-app:checkout-app-inline"},
    "aws_lb_listener.edge_https":         {"service": "edge", "id": "arn:aws:elasticloadbalancing:eu-west-1:111122223333:listener/app/edge/0a1b/443"},
    "aws_lambda_function.report_export":  {"service": "reporting", "id": "report-export"},
    "aws_ebs_encryption_by_default.this": {"service": "platform", "id": "eu-west-1"}
  },
  "principals": {
    "terraform-ci": "iac",
    "breakglass-oncall": "breakglass",
    "platform-engineer": "human",
    "security-engineer": "human",
    "developer": "human",
    "AWSServiceRoleForAutoScaling": "controller",
    "AWSServiceRoleForApplicationAutoScaling_ECSService": "controller",
    "AWSServiceRoleForRDS": "controller"
  },
  "controller_fields": {
    "AWSServiceRoleForAutoScaling": {"aws_autoscaling_group": ["desired_capacity"]},
    "AWSServiceRoleForApplicationAutoScaling_ECSService": {"aws_ecs_service": ["desired_count"]},
    "AWSServiceRoleForRDS": {"aws_db_instance": ["engine_version"]}
  },
  "event_attrs": {
    "AuthorizeSecurityGroupIngress": ["ingress"],
    "RevokeSecurityGroupIngress": ["ingress"],
    "UpdateAutoScalingGroup": ["desired_capacity", "min_size", "max_size"],
    "SetDesiredCapacity": ["desired_capacity"],
    "UpdateService": ["desired_count"],
    "ModifyDBInstance": ["instance_class", "publicly_accessible", "multi_az", "backup_retention_period", "deletion_protection", "engine_version"],
    "ModifyReplicationGroup": ["num_cache_clusters"],
    "DecreaseReplicaCount": ["num_cache_clusters"],
    "IncreaseReplicaCount": ["num_cache_clusters"],
    "PutPublicAccessBlock": ["block_public_policy", "restrict_public_buckets"],
    "DeletePublicAccessBlock": ["block_public_policy", "restrict_public_buckets"],
    "ChangeResourceRecordSets": ["records", "weight", "ttl"],
    "PutRolePolicy": ["policy"],
    "ModifyListener": ["ssl_policy"],
    "UpdateFunctionConfiguration": ["timeout", "memory_size"],
    "CreateTags": ["tags"],
    "DeleteTags": ["tags"],
    "AddTagsToResource": ["tags"],
    "TagResource": ["tags"],
    "UntagResource": ["tags"],
    "RemoveTagsFromResource": ["tags"],
    "DisableEbsEncryptionByDefault": ["enabled"]
  },
  "attr_kinds": {
    "aws_autoscaling_group.desired_capacity": "capacity",
    "aws_autoscaling_group.min_size": "capacity",
    "aws_autoscaling_group.max_size": "capacity",
    "aws_ecs_service.desired_count": "capacity",
    "aws_db_instance.instance_class": "capacity",
    "aws_db_instance.multi_az": "capacity",
    "aws_elasticache_replication_group.num_cache_clusters": "capacity",
    "aws_lambda_function.memory_size": "capacity",
    "aws_route53_record.records": "routing",
    "aws_route53_record.weight": "routing",
    "aws_lb_listener.default_action_target": "routing",
    "*.tags": "cosmetic"
  },
  "ranks": {
    "instance_class": ["db.t3.medium", "db.r6g.large", "db.r6g.xlarge", "db.r6g.2xlarge"],
    "multi_az": [false, true]
  },
  "policies": [
    {"id": "no-world-admin-ports", "type": "aws_security_group", "attr": "ingress", "op": "match", "value": ["tcp/22 0.0.0.0/0", "tcp/3389 0.0.0.0/0"], "severity": 9},
    {"id": "no-world-db-ports", "type": "aws_security_group", "attr": "ingress", "op": "match", "value": ["tcp/5432 0.0.0.0/0", "tcp/3306 0.0.0.0/0", "tcp/6379 0.0.0.0/0"], "severity": 10},
    {"id": "world-ingress-only-web", "type": "aws_security_group", "attr": "ingress", "op": "match", "value": ["* 0.0.0.0/0"], "except": ["tcp/443 0.0.0.0/0", "tcp/80 0.0.0.0/0"], "severity": 6},
    {"id": "s3-block-public", "type": "aws_s3_bucket_public_access_block", "attr": "block_public_policy", "op": "eq", "value": false, "severity": 9},
    {"id": "s3-restrict-public", "type": "aws_s3_bucket_public_access_block", "attr": "restrict_public_buckets", "op": "eq", "value": false, "severity": 9},
    {"id": "rds-not-public", "type": "aws_db_instance", "attr": "publicly_accessible", "op": "eq", "value": true, "severity": 10},
    {"id": "rds-deletion-protection", "type": "aws_db_instance", "attr": "deletion_protection", "op": "eq", "value": false, "severity": 5},
    {"id": "rds-backup-retention", "type": "aws_db_instance", "attr": "backup_retention_period", "op": "lt", "value": 7, "severity": 4},
    {"id": "iam-no-wildcard-action", "type": "aws_iam_role_policy", "attr": "policy", "op": "match", "value": ["*\"Action\":\"[*]\"*", "*\"Action\":[[]\"[*]\"]*"], "severity": 8},
    {"id": "tls-modern-only", "type": "aws_lb_listener", "attr": "ssl_policy", "op": "match", "value": ["ELBSecurityPolicy-2016-08", "ELBSecurityPolicy-TLS-1-0-*"], "severity": 6},
    {"id": "ebs-encryption-default", "type": "aws_ebs_encryption_by_default", "attr": "enabled", "op": "eq", "value": false, "severity": 7},
    {"id": "required-owner-tag", "type": "*", "attr": "tags", "op": "lacks_key", "value": "owner", "severity": 2}
  ]
}
